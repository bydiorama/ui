node_modules/
dist/
build/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
storybook-static/
.next/
coverage/
# design/ stays local except design/motion/, whose storyboards, job specs, demo pages and render tools are sources.
# `design/*` rather than `design/`: git cannot re-include anything inside an excluded directory.
design/*
!design/motion/

# Design exports from Paper. Renders, not sources: the Paper file is the
# source of truth and these PDFs are stale the moment a sheet moves. They are
# also large and binary, so every re-export is a full new blob in history.
design/paper/exports/

# Rendered motion media: the mp4 films and 2× PNG stills under each design/motion/<job>/exports/. Renders, not
# sources: the demo page and design/motion/tools regenerate them, and each re-render would be a new multi-MB
# blob.
design/motion/**/exports/

# Python bytecode. The motion render tools live in registry/skills/ui-video-render/scripts/python/; running them
# writes __pycache__/ beside them, which skills:build would otherwise copy into .claude/skills/ and git would track.
__pycache__/

# Storybook build output and the token CSS it generates (regenerated by `pnpm tokens`).
apps/storybook/styles/tokens.generated.css

# Vitest browser-mode FAILURE artifacts — debugging aids, not baselines. The
# same capture lands twice: named per-test in __screenshots__/ and
# content-hashed in .vitest-attachments/. Deliberate visual-regression
# baselines, when they arrive, live elsewhere and are committed on purpose.
**/__screenshots__/
**/.vitest-attachments/

# ...except the visual-regression BASELINES, which are the opposite of debris:
# a deliberate, reviewed artefact that a diff is measured against. They are
# platform-specific (`-chromium-darwin`), which is why the visual project is
# not in CI — see ledger/decisions and `pnpm test:visual`.
!registry/visual/__screenshots__/
!registry/visual/__screenshots__/**
# ...but NOT the run artifacts that land in the same folder. A failing compare
# writes `-actual-` and `-diff-` PNGs beside the baseline; committing those
# makes the debris look like a reviewed baseline, which is the one thing the
# baseline directory must never contain.
registry/visual/__screenshots__/**/*-actual-*.png
registry/visual/__screenshots__/**/*-diff-*.png

# Belt and braces, ANYWHERE. A failing compare writes these relative to the
# vitest root, not to the test file — `apps/storybook/../registry/...` lands in
# `apps/registry/`, a path with no `__screenshots__` segment that the rules
# above never matched. Four of them were committed before this line existed.
**/*-actual-chromium-*.png
**/*-diff-chromium-*.png
