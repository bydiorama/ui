---
import "../styles/site.css";
import { Github, ArrowUpRight } from "griddy-icons";
import { Search } from "../components/Search";
import { Fade } from "@/ui/fade";
import { buttonClassName } from "@/ui/button";
import { catalog } from "../lib/catalog";
import { copy } from "../lib/copy";
import { appearanceOptions, appearanceAttributes, appearanceStorageKey, defaultAppearance } from "../lib/appearance";
const { title = "Diorama UI", description = copy.description } = Astro.props;
// Theme has no page of its own yet: it leads to the home page's look switch,
// which re-themes the whole page in place.
const nav = [{ label: "Components", href: "/components/" }, { label: "Theme", href: "/#looks" }, { label: "Docs", href: "/docs/" }, { label: "Changelog", href: "/changelog/" }];
const footerNav = [{ label: "Components", href: "/components/" }, { label: "Docs", href: "/docs/" }, { label: "For agents", href: "/docs/agents/" }, { label: "Changelog", href: "/changelog/" }, { label: "GitHub", href: copy.repository }];
const searchEntries = catalog.items.map(({ name, title, lead, category }) => ({ name, title, lead, category }));
const isCurrent = (href: string) => Astro.url.pathname === href || (href === "/components/" && Astro.url.pathname.startsWith(href));
const headerButton = buttonClassName({ variant: "secondary", size: "sm", shape: "full" });
---
<!doctype html>
<html lang="en" data-site-brand="zero" data-ui-density="default" data-site-effects="off">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Diorama UI" ? title : `${title} · Diorama UI`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <link rel="preload" href="/fonts/aspekta/AspektaVF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="For agents" />
    <script define:vars={{ appearanceOptions, appearanceAttributes, appearanceStorageKey, defaultAppearance }}>
      let preferences = {};
      try { preferences = JSON.parse(localStorage.getItem(appearanceStorageKey) || "{}"); }
      catch { /* Storage is optional; the page follows the system. */ }
      for (const key of Object.keys(defaultAppearance)) {
        const value = preferences?.[key];
        document.documentElement.dataset[appearanceAttributes[key]] = appearanceOptions[key].some(option => option.value === value) ? value : defaultAppearance[key];
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="site-header-inner">
        <a href="/" class="wordmark"><span class="wordmark-mark" aria-hidden="true"></span>Diorama UI</a>
        <nav class="desktop-nav" aria-label="Main navigation">{nav.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}</nav>
        <div class="header-tools">
          <Search entries={searchEntries} client:idle />
          <a class:list={[headerButton, "github-link"]} href={copy.repository}><Github aria-hidden="true" />GitHub<ArrowUpRight class="github-link-arrow" aria-hidden="true" /></a>
          <a class:list={[headerButton, "start-link"]} href="/docs/">Get started</a>
          <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation">{nav.map(item => <a href={item.href}>{item.label}</a>)}<a href={copy.repository}>GitHub</a></nav></details>
        </div>
      </div>
      <span class="site-header-fade" aria-hidden="true"><Fade side="top" size="md" ground="affix" /></span>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><p>{copy.footer}</p><nav aria-label="Footer">{footerNav.map(item => <a href={item.href}>{item.label}</a>)}</nav></footer>
    <script>
      import "../lib/interactions";
    </script>
  </body>
</html>
