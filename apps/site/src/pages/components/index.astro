---
import "../../styles/home.css";
import "../../styles/catalog.css";
import Base from "../../layouts/Base.astro";
import Outro from "../../components/Outro.astro";
import Gallery from "../../components/Gallery.astro";
import { LookDock } from "../../home/LookDock";
import catalog from "../../data/catalog.generated.json";

const families = new Set(catalog.items.map(item => item.category)).size;
---
<Base title="Components">
  <div class="catalog-page">
    <header class="catalog-head">
      <div class="catalog-head-title">
        <p class="catalog-eyebrow">{catalog.items.length} components · {families} families</p>
        <h1>Components</h1>
      </div>
      <p class="catalog-lede">Start with the part you need. See how it behaves, read the reasoning, and bring the source into your project.</p>
    </header>
    <LookDock client:load isFloatingOnly />
    <Gallery />
  </div>
  <Outro />
</Base>
