{
  "name": "@bydiorama/ui-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Diorama design system — tokens, components, docs.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "check:manifest": "node scripts/validate-manifest.mjs",
    "check:registry": "node scripts/build-registry.mjs --check",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:ledger": "node scripts/validate-ledger.mjs",
    "check:licensing": "node scripts/lint-licensing.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:utilities": "node --experimental-strip-types scripts/check-utilities.mjs",
    "ledger:new": "node scripts/ledger-new.mjs",
    "test": "node --experimental-strip-types --test \"packages/*/src/**/*.test.ts\" \"registry/**/*.test.ts\"",
    "test:browser": "pnpm --filter @bydiorama/storybook run test:browser",
    "type-check": "tsc --noEmit && pnpm --filter @bydiorama/storybook run type-check",
    "lint": "eslint .",
    "verify": "pnpm run check:manifest && pnpm run check:registry && pnpm run check:dependencies && pnpm run check:ledger && pnpm run check:licensing && pnpm run check:icons && pnpm run check:utilities && pnpm run check:boundaries && pnpm run check:controls && pnpm run check:overlays && pnpm run check:visual-coverage && pnpm run check:visual-runner && pnpm run check:skills && pnpm run check:contrast",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:controls": "node scripts/check-controls.mjs",
    "check:overlays": "node scripts/check-overlays.mjs",
    "check:visual-coverage": "node scripts/check-visual-coverage.mjs",
    "check:visual-runner": "node scripts/check-visual-runner.mjs",
    "design:gaps": "node scripts/report-design-gaps.mjs",
    "skills:build": "node scripts/build-skills.mjs",
    "check:skills": "node scripts/validate-skills.mjs && node scripts/build-skills.mjs --check",
    "test:visual": "pnpm --filter @bydiorama/storybook run test:visual",
    "contrast:build": "node scripts/check-contrast.mjs",
    "check:contrast": "node scripts/check-contrast.mjs --check"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@changesets/cli": "^2.27.0",
    "@storybook/react-vite": "^10.5.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "^4.1.10",
    "clsx": "^2.1.1",
    "eslint": "^9.0.0",
    "griddy-icons": "^0.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.6",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
