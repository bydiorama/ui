{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // Sources import with explicit .ts extensions so Node's type-stripping can
    // run them directly — tests need no build step and no test framework.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,

    // Strictness. Deliberately the same set as the consuming app so a component
    // that type-checks here cannot fail to type-check there.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@bydiorama/tokens": ["./packages/tokens/src/index.ts"],
      "@bydiorama/tokens/*": ["./packages/tokens/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "registry/**/*.ts", "registry/**/*.tsx"],
  "exclude": ["node_modules", "**/dist", "scripts"]
}
