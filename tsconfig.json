{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // Sources import with explicit .ts extensions so Node's type-stripping can
    // run them directly — tests need no build step and no test framework.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,

    // Strictness. Deliberately the same set as the consuming app so a component
    // that type-checks here cannot fail to type-check there.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@bydiorama/tokens": ["./packages/tokens/src/index.ts"],
      "@bydiorama/tokens/*": ["./packages/tokens/src/*"],
      // Registry items import each other the way a CONSUMER will, through the
      // `@/` alias that points at their install targets. Mapping it here means
      // the source we ship is the source we type-check — no rewriting on the
      // way out, and a broken cross-item import fails in our CI, not theirs.
      "@/lib/cn": ["./registry/lib/cn/cn.ts"],
      "@/lib/chrome-control": ["./registry/lib/chrome-control/chrome-control.ts"],
      "@/lib/compose-event-handlers": [
        "./registry/lib/compose-event-handlers/compose-event-handlers.ts"
      ],
      "@/lib/menu-surface": ["./registry/lib/menu-surface/menu-surface.ts"],
      "@/lib/motion": ["./registry/lib/motion/motion.ts"],
      "@/lib/fade-ramp": ["./registry/lib/fade-ramp/fade-ramp.ts"],
      "@/lib/viz": ["./registry/lib/viz/viz.ts"],
      "@/lib/graph": ["./registry/lib/graph/graph.ts"],
      "@/lib/fx": ["./registry/lib/fx/fx.ts"],
      "@/lib/shader": ["./registry/lib/shader/shader.ts"],
      "@/lib/shader-programs": ["./registry/lib/shader/shader-programs.ts"],
      "@/hooks/use-controllable-state": [
        "./registry/hooks/use-controllable-state/use-controllable-state.ts"
      ],
      "@/hooks/use-is-stuck": ["./registry/hooks/use-is-stuck/use-is-stuck.ts"],
      "@/hooks/use-scroll-edges": ["./registry/hooks/use-scroll-edges/use-scroll-edges.ts"],
      "@/hooks/use-graph-viewport": ["./registry/hooks/use-graph-viewport/use-graph-viewport.ts"],
      // A UI item imported BY another UI item must resolve to the path the
      // consumer will have — `ui/calendar.tsx`, the manifest's install target
      // — not to this repo's `ui/calendar/calendar.tsx` folder layout. The
      // wildcard below is the folder form, which tests and stories use and no
      // consumer ever sees; anything a distributed file imports needs an
      // explicit entry here, above the wildcard. `check:dependencies` resolves
      // every `@/` import against the manifest's targets, so a missing entry
      // here is a build error rather than a consumer's problem.
      "@/ui/aspect-ratio": ["./registry/ui/aspect-ratio/aspect-ratio.tsx"],
      "@/ui/fade": ["./registry/ui/fade/fade.tsx"],
      "@/ui/badge": ["./registry/ui/badge/badge.tsx"],
      "@/ui/button": ["./registry/ui/button/button.tsx"],
      "@/ui/table": ["./registry/ui/table/table.tsx"],
      "@/ui/calendar": ["./registry/ui/calendar/calendar.tsx"],
      "@/ui/checkbox": ["./registry/ui/checkbox/checkbox.tsx"],
      "@/ui/menu": ["./registry/ui/menu/menu.tsx"],
      "@/ui/skeleton": ["./registry/ui/skeleton/skeleton.tsx"],
      "@/ui/progress": ["./registry/ui/progress/progress.tsx"],
      "@/ui/slider": ["./registry/ui/slider/slider.tsx"],
      "@/ui/header": ["./registry/ui/header/header.tsx"],
      "@/ui/sheet": ["./registry/ui/sheet/sheet.tsx"],
      "@/ui/chart": ["./registry/ui/chart/chart.tsx"],
      "@/ui/combobox": ["./registry/ui/combobox/combobox.tsx"],
      "@/ui/dot-pattern": ["./registry/ui/dot-pattern/dot-pattern.tsx"],
      "@/ui/diagram": ["./registry/ui/diagram/diagram.tsx"],
      "@/ui/network": ["./registry/ui/network/network.tsx"],
      "@/ui/status-matrix": ["./registry/ui/status-matrix/status-matrix.tsx"],
      "@/ui/popover": ["./registry/ui/popover/popover.tsx"],
      "@/ui/chat-widget": ["./registry/ui/chat-widget/chat-widget.tsx"],
      "@/components/blocks/stat-tiles": ["./registry/blocks/stat-tiles/stat-tiles.tsx"],
      "@/ui/*": ["./registry/ui/*"],
      // Blocks (Phase 3) install to `components/blocks/<name>.tsx`: every
      // shadcn components.json already declares the `components` alias, so a
      // consumer adds nothing. This is the folder form tests and stories use;
      // a distributed file that imports a block needs a consumer-form entry
      // (`@/components/blocks/<name>`) above it, as `@/ui/*` does.
      "@/blocks/*": ["./registry/blocks/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "registry/**/*.ts", "registry/**/*.tsx"],
  // Stories sit beside their components but are not distributed, and their
  // dependencies (Storybook, Vite) live in apps/storybook. This project checks
  // exactly what ships; apps/storybook/tsconfig.json checks the stories with
  // the deps they actually have. Same boundary as the manifest, one level up.
  "exclude": ["node_modules", "**/dist", "scripts", "**/*.stories.tsx"]
}
